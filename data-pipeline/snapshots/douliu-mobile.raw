<script>
$(function () {
$('#btngo').click(function() {
  var link =$('#ddldept').val();
  var WindowMode = $('#ddldept').attr('data-isNewWindow');
     if(WindowMode == 'True') {
         WindowMode='_blank';
     }else{
         WindowMode='_self';
     }
     if(link != '') {
         window.open(link, WindowMode, '');
     }
  })
